,"column":1}},"key":"ZEcGkzFwWh"},{"type":"link","url":"../../applications/narrative-editor.md","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Narrative Editor","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"haKs1JLDey"}],"urlSource":"../../applications/narrative-editor.md","key":"i613a07lOu"},{"type":"break","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qbshPyPzPK"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Estimated time:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eskgb0u0hw"}],"key":"sLHHVmUfip"},{"type":"text","value":" 20–30 minutes","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QuJXH3W74l"},{"type":"break","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qAJF1KxkUt"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Before you start:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zWuh0aGy69"}],"key":"qNblVpynC9"},{"type":"text","value":" You need an EOxHub account, a GitHub account, and access to a Workspace with the Narrative Editor enabled.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cllSfW6oYo"}],"key":"MzdknxGYPF"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"1. Navigate to your EOxHub workspace, for example ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"OjOa1my6Ix"},{"type":"link","url":"https://gtif-austria.info/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"https://​gtif​-austria​.info/","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"C0TUHLstwA"}],"urlSource":"https://gtif-austria.info/","key":"UUpcwbhPAW"},{"type":"text","value":" and log into your account. If you need help doing so, or do not yet own an account, follow the link to find the tutorial covering how to create one: ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"PImsazIpLc"},{"type":"link","url":"../tutorials/creating_account.md","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"How to create an account in EOxHub workspaces","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"aasN5SUaxp"}],"urlSource":"../tutorials/creating_account.md","key":"Egp2oMvk9N"}],"key":"stB82GyeND"},{"type":"image","url":"/build/851daf32323d31956e0b9cf5429e3261.jpeg","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"kehzCUFrJO","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/00a01129-0c30-47b0-8ae1-a62f32920c01/user_cropped_screenshot.webp?tl_px=0,1&br_px=2087,1282&force_format=jpeg&q=100&width=1120.0"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"break","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"s5lEOp5Uqa"},{"type":"text","value":"2. After successfully signing in, find the “Narrative Editor” tile and click on it.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ZGka9daCXG"}],"key":"g4aNO0raQQ"},{"type":"image","url":"/build/6fc8049510c7a22ae8727ffc5b421148.jpeg","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"latrCnqYbB","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/01dd7aaf-923a-4e79-a269-2f9ba98394fd/user_cropped_screenshot.webp?tl_px=131,0&br_px=1850,961&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=524,199"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"break","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"OThFdRFVs4"},{"type":"text","value":"3. If this is your first time using our Narrative Editor, you will have to authorize our tool to interact with your GitHub account.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"Zewd7yoIQ0"}],"key":"r428kx9OJA"},{"type":"image","url":"/build/5e0185488e2afc38735dd0d0d78cc206.jpeg","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"J2nUwCqkmS","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/d683f7a4-6496-48e6-a9c1-e20a5759200f/ascreenshot.jpeg?tl_px=322,322&br_px=2042,1284&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=524,337"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"break","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"PQtlPpqfEr"},{"type":"text","value":"4. After doing so, make sure “All repositories” is selected and click “Install & Authorize”. The Narrative Editor requires access to all repositories to create new narratives. However, it will not edit any of your other repositories.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"SsY4NgFOvP"}],"key":"H4n1YRaTvu"},{"type":"image","url":"/build/a601896d84109c0429981824a6180c4e.jpeg","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"kndJS15fYm","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/c2cbc571-1c60-419a-969c-6a32b2aca426/ascreenshot.jpeg?tl_px=467,71&br_px=2187,1033&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=366,500"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"break","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Cd7bL8HrG6"},{"type":"text","value":"5. To create a narrative, you first need to create a session. Sessions allow you to edit multiple files in one place, and you will create your narrative within the session. To create a session, click “Start New Session” in the top-right corner of your screen.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"WERz2f2PrI"}],"key":"aVE0Eh5zAV"},{"type":"image","url":"/build/ee7b6ccb9382f050290efb020d672990.jpeg","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"P4rwl8lXdu","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/28051729-f558-4b26-b704-c959bd071cba/ascreenshot.jpeg?tl_px=367,0&br_px=2087,961&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=977,31"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"break","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"cqqMcZWgrL"},{"type":"text","value":"6. Your session requires a name, which will be used to more easily find your work on GitHub. After typing in a name, click “Create New Session”.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"YLyXDK4ozE"}],"key":"RurWqnSZNB"},{"type":"image","url":"/build/cbf85868056544dc158a852f76b0d07e.jpeg","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"pzCBsHuMxo","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/26660a28-2fa2-4707-8214-60b555e854d5/ascreenshot.jpeg?tl_px=340,322&br_px=2060,1284&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=524,304"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"break","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"n7tOPOMYFx"},{"type":"text","value":"7. Select “Create Narrative” to create a new narrative. The other two options let you edit existing narratives or upload your own. Neither option makes changes to the original website at this stage.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"EfSWT2xxpI"}],"key":"L6hAx4WmHL"},{"type":"image","url":"/build/89257e309f13156fb49f82b169291f99.jpeg","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"byJDyABauH","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/cfd3f25a-9a07-4d07-a70a-056385131de7/ascreenshot.jpeg?tl_px=0,322&br_px=1719,1284&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=414,323"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"break","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"vn0fKYOubk"},{"type":"text","value":"8. Be sure to give your narrative a name and click “Submit”. This will create a new branch in your linked GitHub account and create a basic template.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"IUCGtrOY43"}],"key":"yiM36X1KJp"},{"type":"image","url":"/build/a694ee8f574e41188d439888b41a668e.jpeg","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"Mrl8LqMFSM","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/c53e4ed3-7e00-4edc-8722-4aa069007ae7/ascreenshot.jpeg?tl_px=367,291&br_px=2087,1252&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=658,277"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"break","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"ZehLPr9b8N"},{"type":"text","value":"9. This template is only in place to get you started. Feel free to change anything you like.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"ZAK2sVBm7j"}],"key":"tvOn2wg39d"},{"type":"image","url":"/build/e19afd3b2b680bedad3fa699f2329929.jpeg","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"CJvlTr8asS","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/5d48ddb6-1c02-48a0-a0c6-262af0e0b49e/user_cropped_screenshot.webp?tl_px=183,161&br_px=1903,1122&force_format=jpeg&q=100&width=1120.0"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"break","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"n4VzOZeBZC"},{"type":"text","value":"10. The title of your narrative, which is also shown on your hero image, is defined with a single hashtag “#”, while each new section in your narrative uses “##”. You can add a subheading to a section by adding another hashtag: “###”. In total, you can add up to four subheadings by adding hashtags.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"u2wpn7gMT0"}],"key":"ElI4eDWpyv"},{"type":"image","url":"/build/caf9b9c7cc712bd3c137173ac4086d80.jpeg","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"KIPVCI22iK","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-10-05/aeccff56-d541-45ba-a194-2a74185e15c2/user_cropped_screenshot.webp?tl_px=470,321&br_px=1616,962&force_format=jpeg&q=100&width=1120.0"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"break","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"ZrOrpDgguI"},{"type":"text","value":"11. The “Hide Preview”/“Show Preview” button at the top allows you to view your changes as you are making them.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"whIWH91Y7F"}],"key":"wI7Cqn2xB1"},{"type":"image","url":"/build/a3a99c8449f2a9997ae770632e514217.jpeg","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"OrIOEKzQg8","urlSource":"https://ajeuwbhvhr.cloudimg.io/https://colony-recorder.s3.amazonaws.com/files/2025-09-28/b1ec9121-a139-4040-aa96-9d37598bfe80/ascreenshot.jpeg?tl_px=325,0&br_px=2045,961&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=524,93"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"break","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"LTM9tvSJRp"},{"type":"text","value":"12. The little “+” icons let you add in new sections, such as paragraphs, maps, images and gifs, without having to type out the markdown syntax manually. Adding a new section, using “##”, will also add a new “+” icon in the preview section.